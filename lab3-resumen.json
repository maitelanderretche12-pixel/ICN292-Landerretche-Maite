              "id": "ff172ad2-24fe-40de-8b55-6cdd0f40e95d",
              "name": "=mensaje",
              "value": "={{(() => { const r=$json.resumen_rutas; const ap=r.find(x=>String(x.ruta).includes('APROBACION')); const rev=r.find(x=>String(x.ruta).includes('REVISION')); const rec=r.find(x=>String(x.ruta).includes('RECHAZO')); const total=r.reduce((s,x)=>s+(x.count_id_solicitud||0),0); const monto=r.reduce((s,x)=>s+(x.sum_monto||0),0); const aprobadas=ap?.count_id_solicitud||0; const tasa=total>0?(aprobadas/total*100).toFixed(2):'0.00'; return `Resumen diario AndesHogar\\n\\nAPROBACION: ${aprobadas} solicitudes - $${ap?.sum_monto||0}\\nREVISION: ${rev?.count_id_solicitud||0} solicitudes - $${rev?.sum_monto||0}\\nRECHAZO: ${rec?.count_id_solicitud||0} solicitudes - $${rec?.sum_monto||0}\\n\\nTotal solicitudes: ${total}\\nMonto total del dia: $${monto}\\nTasa de aprobacion automatica: ${tasa}%`; })()}}",
              "type": "string"
            }
